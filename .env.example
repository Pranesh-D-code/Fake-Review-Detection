# Copy this file to .env.  Never commit .env or share this token in chat.
# Create the token in Apify Console > Settings > Integrations.
REVIEW_PROVIDER=apify
APIFY_API_TOKEN=replace_with_your_Apify_API_token

# This Actor supports Amazon product/review collection.  Keep it configurable:
# its output fields and pricing are controlled by the Actor publisher.
APIFY_AMAZON_REVIEWS_ACTOR=pro100chok/amazon-scraper
APIFY_AMAZON_PRODUCT_ACTOR=pro100chok/amazon-scraper
APIFY_REVIEW_LIMIT=20

# Public review text retained locally for later human labelling and model
# evaluation. Review data may be subject to marketplace terms and privacy law.
STORE_REVIEW_OBSERVATIONS=true

# How many Amazon reviews to request from the provider (1-1000).  Larger pulls cost
# more Apify credit and take longer; APIFY_TIMEOUT_SECONDS (max 290) overrides the wait.
# APIFY_REVIEW_LIMIT=200
# APIFY_TIMEOUT_SECONDS=240

# Fake-review text model (models/review_detector.joblib).  Set false to use rules only.
ENABLE_ML_DETECTOR=true
# REVIEW_MODEL_PATH=models/review_detector.joblib

# Extended cross-store matching (config/stores.json).  Set false for the legacy search only.
ENHANCED_MATCHING=true
ENHANCED_MAX_STORES=6

# The legacy Amazon<->Flipkart search sometimes returns page text ("Need help?") or accessories
# (a phone's back cover); these are hidden by default.  Set false to show every raw hit.
# LEGACY_RESULT_FILTER=true

# Real/Fake buttons on reviews feed the model.  A retrain starts after this many new labels.
# AUTO_RETRAIN=true
# AUTO_RETRAIN_MIN_NEW_LABELS=50

# Most reviews read per pasted link from the store's own public pages (5-1000).
# REVIEW_FETCH_LIMIT=150

# The 'suspicious' flag from the text model never goes below this probability (the model's own cut-off may be higher).
# REVIEW_FLAG_MIN_PROBABILITY=0.9

# Open every listed product link once and drop the ones that do not open (default true).
LINK_CHECK=true
